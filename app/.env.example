INSTANCE=_toolkit
NETWORK=network
TRAEFIK_ENABLE=true
TRAEFIK_DOMAIN=toolkit.localhost
TRAEFIK_ENTRYPOINT=web
# Стенд слушает только на 127.0.0.1: в контейнере выполняется произвольный код агента.
EXTERNAL_ACCESS=127.0.0.1:8092:80
# Пароль на страницы стенда. Работает, только когда заданы оба.
HTTP_LOGIN=
HTTP_PASSWORD=
NGINX_CONF=toolkit
# Версии образов и инструментов запечены: latest уходит вперёд молча.
NGINX_VERSION=1.29-alpine
NODE_VERSION=22
MISE_VERSION=v2026.10.1
# Версия pg_dump в образе. Должна быть не ниже версии самого старшего из ваших серверов postgres.
PG_CLIENT_VERSION=17
# Дополнительные пакеты Debian в образ, через пробел
NODE_APT_PACKAGES=
# Потолок загрузки через /upload на стороне nginx. Поднимая, поднимите и TK_MAX_UPLOAD_BYTES.
CLIENT_MAX_BODY_SIZE=256M

# MCP
NODE_MODE=mcp
MCP_PORT=8933
MCP_ACCESS=127.0.0.1:8933:8933
# База ссылок /files/… и страниц в ответах агенту
PUBLIC_BASE_URL=http://127.0.0.1:8092

# Язык описаний инструментов MCP: ru | en | auto.
# Их читает модель, поэтому язык стоит выставлять по языку задач, а не интерфейса.
TK_LANG=ru

# Подтверждения доступа к удалённым серверам — пользователю на сервере (user@host), по разу за сессию.
#   host  — первый вызов спрашивает доступ («только чтение» или сразу «чтение и запись»),
#           первая запись при выданном чтении — ещё раз; дальше молча. Отказ запоминается.
#   write — чтение без вопросов, спрашивается только запись.
#   off   — не спрашивать. Цель с readonly: true спрашивает про каждую запись при любом значении.
# Работа в рабочей области стенда не спрашивается никогда.
TK_APPROVAL=host
# Сколько секунд ждать решения человека, прежде чем отказать вызову
TK_APPROVE_TIMEOUT=300

# Сервис секретов для ссылок secret://<id>. Пока не задан, такие ссылки отклоняются,
# а секреты передаются значением или файлом рабочей области (ws:<путь>).
# Запрос: GET <url>?ref=<ссылка> с заголовком Authorization: Bearer <токен>, ответ {"value": "…"}.
TK_SECRET_RESOLVER_URL=
TK_SECRET_RESOLVER_TOKEN=
TK_SECRET_RESOLVER_TIMEOUT=10

# Тулчейны (mise). Списки версий mise берёт с mise-versions.jdx.dev; он за Cloudflare и
# доступен не везде. Стенд проверяет его при старте и, если не отвечает, сам переключает
# mise на первоисточники, а python — на сборку из исходников. Заданные здесь значения
# этот выбор отменяют:
# MISE_USE_VERSIONS_HOST=false
# MISE_PYTHON_COMPILE=true
# Токен GitHub для mise: без него API GitHub даёт 60 запросов в час на адрес, а списки
# версий python, go и плагинов идут через него. Права не нужны — подойдёт пустой fine-grained.
# MISE_GITHUB_TOKEN=

# Рабочая среда. Сколько секунд вызов ждёт команду, прежде чем отдать её в фон задачей:
# клиенты MCP обрывают долгие вызовы, а сборка php длится минуты.
TK_FOREGROUND_TIMEOUT=50
# Сколько завершённых задач хранить вместе с логами
TK_JOBS_KEEP=200

# Проверка обновлений: при старте стенд один раз спрашивает GitHub, какой релиз последний,
# и сравнивает с тегом из BUNDLE_IMAGE. Ничего не блокирует, ответ кэшируется на шесть часов.
# 0 выключает — для контуров без выхода наружу. Форкам: TK_UPDATE_REPO и TK_UPDATE_IMAGE.
TK_UPDATE_CHECK=1

# Журнал. Файлы JSONL в томе logs, вывод команд целиком; секреты заменены приметами.
TK_LOG_MAX_BYTES=1073741824
TK_LOG_FILE_BYTES=67108864
# Вывод и аргументы крупнее этого уезжают в отдельный файл logs/blobs/<id>.<поле>.txt
TK_LOG_INLINE_BYTES=262144

# Потолки ответов агенту: контекст модели дороже полноты вывода.
TK_MAX_TEXT_BYTES=131072
TK_DB_MAX_ROWS=500
TK_MAX_UPLOAD_BYTES=268435456
# Потолок вывода одной удалённой команды, который сервер держит в памяти
TK_MAX_OUTPUT_BYTES=33554432

# Транспорт
# Через сколько миллисекунд простоя закрывать SSH-соединение из пула
TK_SSH_IDLE_MS=300000
# Таймаут одной команды по умолчанию, миллисекунды
TK_EXEC_TIMEOUT=120000
